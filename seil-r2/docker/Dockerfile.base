# Base image for the seil-r2 colcon workspace: ROS 2 Humble plus every system
# dependency the packages under src/ declare in their package.xml.
#
#   docker build -f docker/Dockerfile.base -t iddmbse-seil-r2-base .
#
# The build context is the workspace root (the directory holding src/).

ARG ROS2_BASE_IMAGE_ARG=ros:humble-ros-base
FROM ${ROS2_BASE_IMAGE_ARG} AS base

# ROS 2 distribution inside the image; must match the base image above
ARG ROS2_DISTRO_ARG=humble
ENV ROS2_DISTRO=${ROS2_DISTRO_ARG}

# Where the colcon workspace lives inside the container
ARG WORKSPACE_PATH_ARG=/workspace/seil-r2
ENV WORKSPACE_PATH=${WORKSPACE_PATH_ARG}

# Home directory of the container user
ARG DOCKER_USER_HOME_ARG=/root
ENV DOCKER_USER_HOME=${DOCKER_USER_HOME_ARG}

SHELL ["/bin/bash", "-c"]
ENV LANG=C.UTF-8
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    git \
    ncurses-term && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# The package manifests decide what gets installed, so the sources are copied in
# and rosdep resolves them (Nav2, rviz2, pointcloud_to_laserscan, ...).
COPY src ${WORKSPACE_PATH}/src

RUN apt-get update && \
    rosdep update --rosdistro ${ROS2_DISTRO} && \
    rosdep install --from-paths ${WORKSPACE_PATH}/src --ignore-src -y --rosdistro ${ROS2_DISTRO} && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# DDS profiles, used when the workspace talks to a simulator running on the host
COPY docker/.ros/ ${DOCKER_USER_HOME}/.ros/

COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh && \
    echo "source /opt/ros/${ROS2_DISTRO}/setup.bash" >> ${DOCKER_USER_HOME}/.bashrc

WORKDIR ${WORKSPACE_PATH}
ENTRYPOINT ["/entrypoint.sh"]
CMD ["bash"]
