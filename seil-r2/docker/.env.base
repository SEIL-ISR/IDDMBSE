###
# General settings
###

# ROS 2 distribution the workspace targets
ROS2_DISTRO=humble
# Image the base profile builds on (must carry the distribution above)
ROS2_BASE_IMAGE=ros:humble-ros-base
# Where the colcon workspace lives inside the container
DOCKER_WORKSPACE_PATH=/workspace/seil-r2
# Docker user directory - by default this is the root user's home directory
DOCKER_USER_HOME=/root
# Isaac Sim version the isaacsim package launches on the host (src/isaacsim)
ISAACSIM_VERSION=4.1.0
