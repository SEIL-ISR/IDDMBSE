###
# ROS 2 specific settings
###
# These names carry a SEILR2_ prefix so that a ROS 2 environment on the host cannot
# leak into the container through Docker Compose's variable substitution.

# ROS 2 middleware implementation to use (e.g. rmw_fastrtps_cpp, rmw_cyclonedds_cpp)
SEILR2_RMW_IMPLEMENTATION=rmw_fastrtps_cpp
# Domain the container's ROS 2 graph joins
SEILR2_ROS_DOMAIN_ID=0
# DDS profiles copied into the image; the directory is DOCKER_USER_HOME/.ros
SEILR2_FASTRTPS_PROFILES_FILE=/root/.ros/fastdds.xml
SEILR2_CYCLONEDDS_URI=/root/.ros/cyclonedds.xml
