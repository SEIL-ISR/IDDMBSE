<?xml version="1.0"?>
<robot name="sensors" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- <material name="dark_grey"><color rgba="0.2 0.2 0.2 1.0" /></material>
  <material name="black"><color rgba="0.15 0.15 0.15 1.0" /></material> -->

  <xacro:property name="yaml_file" value="$(find hardware_description)/config/sensor.yaml" />
  <xacro:property name="config" value="${xacro.load_yaml(yaml_file)}"/>

  <!--
    Add/remove a 2D lidar sensor by changing the LASER_2D environment variable. The default model is the SICK LMS1xx, but this can be changed with the LASER_MODEL environment variable. Valid model designations are:
    - lms1xx (default) :: SICK LMS1xx
    - ust10            :: Hokuyo UST-10LX
  -->

   <!-- <xacro:if value="${lidar_model == 'lms1xx'}">
      <xacro:include filename="$(find hardware_description)/urdf/sensors/lasers/sick_lms1xx_mount.urdf.xacro" />
      
      <xacro:sick_lms_1xx name="sick_lms1xx" ros_topic="${config['laser_2d']['topic']}" />
      
      <joint name="${config['laser_2d']['parent']}_sick_lms1xx_laser_joint" type="fixed">
        <origin xyz="${config['laser_2d']['position']}" rpy="${config['laser_2d']['orientation']}" />
        <parent link="${config['laser_2d']['parent']}" />
        <child link="sick_lms1xx_mount_link" />
      </joint>
    </xacro:if> -->


  <xacro:if value="${config['laser_2d']['enabled']}">
    <xacro:property name="lidar_model" value="${config['laser_2d']['model']}" />

    <xacro:if value="${lidar_model == 'lms1xx'}">
      <xacro:include filename="$(find hardware_description)/urdf/sensors/lasers/sick_lms1xx_mount.urdf.xacro" />
      
      <xacro:sick_lms1xx_mount prefix="${config['laser_2d']['prefix']}" parent="${config['laser_2d']['parent']}"
                               topic="${config['laser_2d']['topic']}" update_rate="${config['laser_2d']['update_rate']}"
                               min_range="${config['laser_2d']['min_range']}" max_range="${config['laser_2d']['max_range']}">
      
        <origin xyz="${config['laser_2d']['position']}" rpy="${config['laser_2d']['orientation']}" />
      </xacro:sick_lms1xx_mount>
    </xacro:if>

    <xacro:if value="${lidar_model == 'ust10'}">
      <xacro:include filename="$(find urg_node)/urdf/hokuyo_ust10.urdf.xacro" />

      <xacro:hokuyo_ust10_mount topic="${config['laser_2d']['topic']}" prefix="hokuyo" parent_link="${config['laser_2d']['parent']}">
        <origin xyz="${config['laser_2d']['position']}" rpy="${config['laser_2d']['orientation']}" />
      </xacro:hokuyo_ust10_mount>
    </xacro:if>
  </xacro:if> 

  <!--
    Add/remove a 3D lidar sensor by changing the CPR_LASER_3D environment variable. The default model is the Velodyne VLP16, but this can be changed with the CPR_LASER_3D_MODEL environment variable. Valid model designations are:
    - vlp16 (default)  :: Velodyne VLP-16
    - hdl32e           :: Velodyne HDL-32E
  -->

  <xacro:if value="${config['laser_3d']['enabled']}">
    <xacro:property name="lidar_3d_model" value="${config['laser_3d']['model']}" />
    
    <xacro:if value="${lidar_3d_model == 'vlp16'}">
        <xacro:include filename="$(find hardware_description)/urdf/sensors/lasers/vlp16_mount.urdf.xacro" />
        <xacro:if value="${config['laser_3d']['tower']}">
            <xacro:vlp16_mount prefix="${config['laser_3d']['prefix']}" parent_link="${config['laser_3d']['parent']}" topic="${config['laser_3d']['topic']}"
                               hz="${config['laser_3d']['update_rate']}" min_range="${config['laser_3d']['min_range']}"
                               max_range="${config['laser_3d']['max_range']}" noise="${config['laser_3d']['noise']}"
                               gpu="${config['laser_3d']['gpu']}">
                <origin xyz="${config['laser_3d']['position']}" rpy="${config['laser_3d']['orientation']}" />
            </xacro:vlp16_mount>
        </xacro:if>
        <xacro:unless value="${config['laser_3d']['tower']}">
            <xacro:VLP-16 parent="${config['laser_3d']['parent']}" topic="${config['laser_3d']['topic']}" name="${config['laser_3d']['prefix']}velodyne"
                          hz="${config['laser_3d']['update_rate']}" min_range="${config['laser_3d']['min_range']}"
                          max_range="${config['laser_3d']['max_range']}" noise="${config['laser_3d']['noise']}"
                          gpu="${config['laser_3d']['gpu']}">
                <origin xyz="${config['laser_3d']['position']}" rpy="${config['laser_3d']['orientation']}" />
            </xacro:VLP-16>
        </xacro:unless>
    </xacro:if>
  </xacro:if>

    <!-- <xacro:if value="${lidar_3d_model == 'hdl32e'}">
      <xacro:include filename="$(find hardware_description)/urdf/sensors/lasers/HDL-32E_mount.urdf.xacro" />

      <xacro:HDL-32E parent="${config['laser_3d']['parent']}" topic="${config['laser_3d']['topic']}">
        <origin xyz="${config['laser_3d']['position']}" rpy="${config['laser_3d']['orientation']}" />
      </xacro:HDL-32E>
    </xacro:if>
  </xacro:if> -->

  <!--
    Add/remove a serial GNSS/GPS sensor by changing the CPR_GPS environment variable. The default model is the Novatel SMART7, but this can be changed with the CPR_GPS_MODEL environment variable. Valid model designations are:
    - smart7 (default)  :: Novatel SMART7
    - 18x               :: Garmin 18x
  -->
  <!-- <xacro:if value="$(optenv CPR_GPS 0)">
    <xacro:property name="gps_model" value="$(optenv CPR_GPS_MODEL smart7)" />

    <xacro:if value="${gps_model == 'smart7'}">
      <xacro:include filename="$(find cpr_robot_customizer)/urdf/accessories/gps/novatel_smart7.urdf.xacro" />

      <xacro:novatel_smart7 />
    </xacro:if>

    <xacro:if value="${gps_model == '18x'}">
      <xacro:include filename="$(find cpr_robot_customizer)/urdf/accessories/gps/garmin_18x.urdf.xacro" />

      <xacro:garmin_18x />
    </xacro:if>

    <joint name="$(optenv CPR_GPS_PARENT base_link)_gps_link_joint" type="fixed">
      <origin xyz="$(optenv CPR_GPS_XYZ 0 0 0)" rpy="$(optenv CPR_GPS_RPY 0 0 0)" />
      <parent link="$(optenv CPR_GPS_PARENT base_link)" />
      <child link="gps_link" />
    </joint>
  </xacro:if> -->

  <!--
    Add/remove an IMU sensor by changing the CPR_MICROSTRAIN environment variable. This supports the LORD MicroStrain GX3, GX4, GX5, CX5, RQ1 and GQ7 series IMU sensors.
  -->
  <!-- <xacro:if value="$(optenv CPR_MICROSTRAIN 0)">
    <xacro:include filename="$(find cpr_robot_customizer)/urdf/accessories/imu/microstrain.urdf.xacro" />

    <xacro:microstrain />

    <joint name="$(optenv CPR_MICROSTRAIN_PARENT base_link)_microstrain_link_joint" type="fixed">
      <origin xyz="$(optenv CPR_MICROSTRAIN_XYZ 0 0 0)" rpy="$(optenv CPR_MICROSTRAIN_RPY 0 0 0)" />
      <parent link="$(optenv CPR_MICROSTRAIN_PARENT base_link)" />
      <child link="microstrain_link" />
    </joint>
  </xacro:if> -->

  <!--
    Add/remove an Intel RealSense family camera by changing the CPR_REALSENSE environment variable. The default model is the D435, but can be changed with the
    CPR_REALSENSE_MODEL environment variable. Valid model designations are:
    - d435 (default)
    - d435i
    - d415
    - d455
    - l515
  -->
  <xacro:if value="${config['depth_camera']['enabled']}">
    <xacro:include filename="$(find hardware_description)/urdf/sensors/cameras/intel_realsense.urdf.xacro" />
    <xacro:realsense_sensor rs_model="${config['depth_camera']['model']}"
                            prefix="${config['depth_camera']['prefix']}"
                            parent="${config['depth_camera']['parent']}"
                            topic="${config['depth_camera']['topic']}"
                            width="${config['depth_camera']['width']}"
                            height="${config['depth_camera']['height']}"
                            h_fov="${config['depth_camera']['h_fov']}"
                            v_fov="${config['depth_camera']['v_fov']}"
                            update_rate="${config['depth_camera']['update_rate']}">
      <origin xyz="${config['depth_camera']['position']}" rpy="${config['depth_camera']['orientation']}"/>
    </xacro:realsense_sensor>
  </xacro:if>

  <!--
    Add/remove an FLIR BlackFly S camera by changing the CPR_REALSENSE environment variable.
  -->

  <xacro:if value="${config['camera']['enabled']}">
    <xacro:include filename="$(find hardware_description)/urdf/sensors/cameras/flir_blackfly_mount.urdf.xacro" />
    <xacro:flir_blackfly_mount prefix="${config['camera']['prefix']}"
                            parent="${config['camera']['parent']}"
                            mount_enabled="${config['camera']['mount_enabled']}"
                            mount_angle="${config['camera']['mount_angle']}"
                            name="${config['camera']['name']}"
                            width="${config['camera']['width']}"
                            height="${config['camera']['height']}"
                            hfov="${config['camera']['h_fov']}"
                            fps="${config['camera']['update_rate']}"
                            near="${config['camera']['min_range']}"
                            far="${config['camera']['max_range']}">
      <origin xyz="${config['camera']['position']}" rpy="${config['camera']['orientation']}"/>
</xacro:flir_blackfly_mount>
  </xacro:if>

</robot>
