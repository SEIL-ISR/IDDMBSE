                {
                    "envvar": "TURTLEBOT3_MODEL",
                    "value": "waffle"
                },
                {
                    "envvar": "GAZEBO_MODEL_PATH",
                    "value": "/opt/ros/humble/share/turtlebot3_gazebo/models"
