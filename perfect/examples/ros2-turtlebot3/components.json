                            "value": "nav_to_pose_with_consistent_replanning_and_if_path_becomes_invalid.xml"
                        }
                    ]
                }
            ]
        }
    },
    {
        "name": "Navigate to Pose w/Replanning and Recovery",
        "type": "behavior_tree",
        "implementation": {
            "files": [
                {
                    "file": "nav2_params.yaml",
                    "updates": [
                        {
                            "keys": "bt_navigator.ros__parameters.default_nav_to_pose_bt_xml",
