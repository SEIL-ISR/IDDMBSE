{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "/perfect/component_implementation",
    "title": "ComponentImplementation",
    "description": "Specification of a ComponentImplementation for a PERFECT project",
    "type": "object",
    "anyOf": [
        {
            "required": [
                "envvars"
            ]
        },
        {
            "required": [
                "files"
            ]
        },
        {
            "required": [
                "launchargs"
            ]
        }
    ],
    "properties": {
        "envvars": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "envvar": {
                        "type": "string"
                    },
                    "value": {
                        "type": "string"
                    }
                },
                "required": [
                    "envvar",
                    "value"
                ]
            }
        },
        "files": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "file": {
                        "type": "string"
                    },
                    "updates": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "keys": {
                                    "type": "string"
                                },
                                "value": {
                                    "type": [
                                        "array",
                                        "number",
                                        "object",
                                        "string"
                                    ]
                                }
                            },
                            "required": [
                                "keys",
                                "value"
                            ]
                        }
                    }
                },
                "required": [
                    "file",
                    "updates"
                ]
            }
        },
        "launchargs": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "arg": {
                        "type": "string"
                    },
                    "value": {
                        "type": [
                            "number",
                            "string"
                        ]
                    }
                },
                "required": [
                    "arg",
                    "value"
                ]
            }
        }
    }
}