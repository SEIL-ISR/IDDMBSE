{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "/perfect/robot",
    "type": "array",
    "items": {
        "$ref": "#/$defs/component"
    },
    "$defs": {
        "component": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string"
                },
                "id": {
                    "type": "number"
                },
                "specification": {
                    "$ref": "/perfect/component"
                }
            },
            "required": [
                "name"
            ],
            "anyOf": [
                {
                    "required": [
                        "id"
                    ]
                },
                {
                    "required": [
                        "specification"
                    ]
                }
            ]
        }
    }
}