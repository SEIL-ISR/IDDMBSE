#usda 1.0
(
    "IDDMBSE test-range design of experiments: density=0.4 slope_p99=None friction=0.7/0.6 restitution=0.0 seed=0"
    subLayers = [
        @../sim_world2.usd@
    ]
)

over "World"
{
    over "terrain1_world"
    {
        over "terrain1"
        {
            float3 xformOp:scale = (2.42, 2.37976, 1)

            over "terrain_low"
            {
                over "mesh" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding:physics = </World/doe_physics_material>
                }
            }
        }
    }

    def Material "doe_physics_material" (
        apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        float physics:dynamicFriction = 0.6
        float physics:restitution = 0
        float physics:staticFriction = 0.7
    }

