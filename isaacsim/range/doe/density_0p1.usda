#usda 1.0
(
    "IDDMBSE test-range design of experiments: density=0.1 slope_p99=None friction=0.7/0.6 restitution=0.0 seed=0"
    subLayers = [
        @../sim_world2.usd@
    ]
)

over "World"
{
    over "terrain1_world"
    {
        over "terrain1"
        {
            float3 xformOp:scale = (2.42, 2.37976, 1)

            over "terrain_low"
            {
                over "mesh" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding:physics = </World/doe_physics_material>
                }
            }
        }
    }

    def Material "doe_physics_material" (
        apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        float physics:dynamicFriction = 0.6
        float physics:restitution = 0
        float physics:staticFriction = 0.7
    }

    def Xform "doe_obstacles"
    {
        def Xform "rock_0000" (
            prepend apiSchemas = ["MaterialBindingAPI"]
            prepend references = @../rocks/Rock_1.usd@
        )
        {
            rel material:binding:physics = </World/doe_physics_material>
            quatf xformOp:orient = (-0.56394386, 0, 0, 0.8258131)
            double xformOp:rotateX:unitsResolve = 90
            float3 xformOp:scale = (9.011126, 9.011126, 9.011126)
            double3 xformOp:scale:unitsResolve = (0.01, 0.01, 0.01)
            double3 xformOp:translate = (5.9106948580877825, 37.40260863813619, 3.1030111150698882)
            token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale", "xformOp:rotateX:unitsResolve", "xformOp:scale:unitsResolve"]

            over "Rock_1"
            {
                over "Rock_1" (
                    prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
                )
                {
                    token physics:approximation = "convexHull"
                    bool physics:collisionEnabled = 1
                }
            }
        }

