#usda 1.0
(
    "IDDMBSE test-range design of experiments: density=0.3 slope_p99=15.0 friction=0.6/0.5 restitution=0.1 seed=7"
    subLayers = [
        @../sim_world2.usd@
    ]
)

over "World"
{
    over "terrain1_world"
    {
        over "terrain1"
        {
            float3 xformOp:scale = (2.42, 2.37976, 0.21304803)

            over "terrain_low"
            {
                over "mesh" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding:physics = </World/doe_physics_material>
                }
            }
        }
    }

    def Material "doe_physics_material" (
        apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        float physics:dynamicFriction = 0.5
        float physics:restitution = 0.1
        float physics:staticFriction = 0.6
    }

    def Xform "doe_obstacles"
    {
        def Xform "rock_0000" (
            prepend apiSchemas = ["MaterialBindingAPI"]
            prepend references = @../rocks/Rock_5.usd@
