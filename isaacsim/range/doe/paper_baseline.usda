            rel material:binding:physics = </World/doe_physics_material>
            quatf xformOp:orient = (-0.8740687, 0, 0, 0.4858024)
            double xformOp:rotateX:unitsResolve = 90
            float3 xformOp:scale = (0.4669687, 0.4669687, 0.4669687)
            double3 xformOp:scale:unitsResolve = (0.01, 0.01, 0.01)
            double3 xformOp:translate = (-44.45631399272156, 28.614528568834473, 0.20572031611251412)
            token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale", "xformOp:rotateX:unitsResolve", "xformOp:scale:unitsResolve"]

            over "Rock_5"
            {
                over "Rock_5" (
                    prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
                )
                {
                    token physics:approximation = "convexHull"
                    bool physics:collisionEnabled = 1
                }
            }
        }

