#usda 1.0
(
    customLayerData = {
        dictionary navmeshSettings = {
            double agentMaxFloorSlope = 20
            double agentMaxRadius = 0.5
            double agentMaxStepHeight = 0.25
            double agentMinHeight = 2
            double agentMinIslandRadius = 2
            double agentMinRadius = 0.2
            double agentSamplingDistance = 0.2
            dictionary areas = {
                dictionary "0" = {
                    string areaName = "Walkable"
                    float3 color = (0.2, 0.8, 1)
                    double defaultCost = 1
                }
                dictionary "1" = {
                    string areaName = "NotWalkable"
                    float3 color = (1, 0, 0)
                    double defaultCost = -1
                }
            }
            bool excludeRigidBodies = 1
        }
    }
    defaultPrim = "World"
    endTimeCode = 86400
    metersPerUnit = 1
    subLayers = [
        @carter_warehouse_animated.usda@
    ]
    upAxis = "Z"
)

over "World"
{
    over "CbaseWarehouseMaze"
    {
        custom string cbase:scene_scope = "irregular warehouse clutter field"
        custom string cbase:source_scene = "carter_warehouse_animated.usda"

        over "StaticProps" (
            active = false
