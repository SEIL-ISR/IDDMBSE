    over "Nova_Carter_ROS"
    {
        over "back_hawk"
        {
            over "left_camera_publish_image"
            {
                custom token inputs:type (
                    allowedTokens = ["rgb", "depth", "depth_pcl", "instance_segmentation", "semantic_segmentation", "bbox_2d_tight", "bbox_2d_loose", "bbox_3d", "camera_info", "rgb_h264", "rgb_hevc"]
                )
            }

            over "right_camera_publish_image"
            {
                custom token inputs:type (
                    allowedTokens = ["rgb", "depth", "depth_pcl", "instance_segmentation", "semantic_segmentation", "bbox_2d_tight", "bbox_2d_loose", "bbox_3d", "camera_info", "rgb_h264", "rgb_hevc"]
                )
            }
        }

        over "back_owl"
        {
            over "publish_image"
            {
                custom token inputs:type (
                    allowedTokens = ["rgb", "depth", "depth_pcl", "instance_segmentation", "semantic_segmentation", "bbox_2d_tight", "bbox_2d_loose", "bbox_3d", "camera_info", "rgb_h264", "rgb_hevc"]
                )
            }
        }

        over "front_hawk"
        {
            over "right_camera_publish_image"
            {
                custom token inputs:type (
                    allowedTokens = ["rgb", "depth", "depth_pcl", "instance_segmentation", "semantic_segmentation", "bbox_2d_tight", "bbox_2d_loose", "bbox_3d", "camera_info", "rgb_h264", "rgb_hevc"]
                )
            }

            over "left_camera_publish_image"
            {
                custom token inputs:type (
                    allowedTokens = ["rgb", "depth", "depth_pcl", "instance_segmentation", "semantic_segmentation", "bbox_2d_tight", "bbox_2d_loose", "bbox_3d", "camera_info", "rgb_h264", "rgb_hevc"]
                )
            }
        }

        over "front_owl"
        {
            over "publish_image"
            {
                custom token inputs:type (
                    allowedTokens = ["rgb", "depth", "depth_pcl", "instance_segmentation", "semantic_segmentation", "bbox_2d_tight", "bbox_2d_loose", "bbox_3d", "camera_info", "rgb_h264", "rgb_hevc"]
                )
            }
        }

        over "left_hawk"
        {
            over "right_camera_publish_image"
            {
                custom token inputs:type (
                    allowedTokens = ["rgb", "depth", "depth_pcl", "instance_segmentation", "semantic_segmentation", "bbox_2d_tight", "bbox_2d_loose", "bbox_3d", "camera_info", "rgb_h264", "rgb_hevc"]
                )
            }

            over "left_camera_publish_image"
            {
                custom token inputs:type (
                    allowedTokens = ["rgb", "depth", "depth_pcl", "instance_segmentation", "semantic_segmentation", "bbox_2d_tight", "bbox_2d_loose", "bbox_3d", "camera_info", "rgb_h264", "rgb_hevc"]
                )
            }
        }

        over "left_owl"
        {
            over "publish_image"
            {
                custom token inputs:type (
                    allowedTokens = ["rgb", "depth", "depth_pcl", "instance_segmentation", "semantic_segmentation", "bbox_2d_tight", "bbox_2d_loose", "bbox_3d", "camera_info", "rgb_h264", "rgb_hevc"]
                )
            }
        }

        over "right_hawk"
        {
            over "left_camera_publish_image"
            {
                custom token inputs:type (
                    allowedTokens = ["rgb", "depth", "depth_pcl", "instance_segmentation", "semantic_segmentation", "bbox_2d_tight", "bbox_2d_loose", "bbox_3d", "camera_info", "rgb_h264", "rgb_hevc"]
                )
            }

            over "right_camera_publish_image"
            {
                custom token inputs:type (
                    allowedTokens = ["rgb", "depth", "depth_pcl", "instance_segmentation", "semantic_segmentation", "bbox_2d_tight", "bbox_2d_loose", "bbox_3d", "camera_info", "rgb_h264", "rgb_hevc"]
                )
            }
        }

        over "right_owl"
        {
            over "publish_image"
            {
                custom token inputs:type (
                    allowedTokens = ["rgb", "depth", "depth_pcl", "instance_segmentation", "semantic_segmentation", "bbox_2d_tight", "bbox_2d_loose", "bbox_3d", "camera_info", "rgb_h264", "rgb_hevc"]
                )
            }
        }

        over "differential_drive"
        {
            over "joint_name_array"
            {
                custom token inputs:input0
                delete token inputs:input0.connect = </World/Nova_Carter_ROS/differential_drive/joint_wheel_left_name.inputs:value>
                prepend token inputs:input0.connect = </World/Nova_Carter_ROS/differential_drive/joint_wheel_left_name.inputs:value>
                custom token inputs:input1
                delete token inputs:input1.connect = </World/Nova_Carter_ROS/differential_drive/joint_wheel_right_name.inputs:value>
                prepend token inputs:input1.connect = </World/Nova_Carter_ROS/differential_drive/joint_wheel_right_name.inputs:value>
            }
        }
    }

    over "maze_overview_camera"
    {
        float exposure:fStop = 5
        float exposure:responsivity = 1.1026709
        float exposure:time = 0.02
    }

    over "maze_aisle_camera"
    {
        float exposure:fStop = 5
        float exposure:responsivity = 1.1026709
        float exposure:time = 0.02
    }
}

over "Render"
{
    over "OmniverseKit"
    {
        over "HydraTextures"
        {
            over "omni_kit_widget_viewport_ViewportTexture_0" (
                prepend apiSchemas = ["OmniRtxSettingsParticleFieldAPI_1"]
            )
            {
                rel camera = </World/maze_aisle_camera>
                rel orderedVars = </Render/Vars/LdrColor>
                custom bool overrideClipRange = 0
                uniform int2 resolution = (1920, 1080)
            }
        }
    }
}

